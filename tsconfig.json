{
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "esnext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "remotion.config.ts"]
}
